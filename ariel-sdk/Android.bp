android_app {
    name: "com.arielos.platform-res",
    use_resource_processor: false,
    sdk_version: "core_platform",
    certificate: "platform",

    manifest: "ariel/res/AndroidManifest.xml",

    // Disable dexpreopt and verify_uses_libraries check as the app
    // contains no Java code to be dexpreopted.
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },

    // Soong special-cases com.arielos.platform-res to install this alongside
    // the libraries at /system_ext/framework/com.arielos.platform-res.apk.

    aaptflags: [
        "--private-symbols",
        "com.arielos.platform.internal",

        // Framework doesn't need versioning since it IS the platform.
        "--no-auto-version",

        // Allow overlay to add resource
        "--auto-add-overlay",

        // Tell aapt to create "extending (non-application)" resource IDs,
        // since these resources will be used by many apps.
        "--allow-reserved-package-id",
        // Use id 0x3f (one less than app id).
        "--package-id",
        "73",
    ],

    resource_dirs: [
        "ariel/res/res",
        "sdk/internal/res/res",
        "sdk/public/res/res",
    ],

    // Create package-export.apk, which other packages can use to get
    // PRODUCT-agnostic resource data like IDs and type definitions.
    export_package_resources: true,
}

// The ArielOS Platform Framework Library
// ============================================================

filegroup {
    name: "ariel-sdk-sources",
    srcs: [
        "sdk/public/src/java/arielos/**/*.java",
        "sdk/public/src/java/arielos/**/I*.aidl",
    ],
}

filegroup {
    name: "ariel-sdk-internal-sources",
    srcs: [
        "sdk/internal/src/java/com/arielos/internal/**/*.java",
        "sdk/internal/src/java/com/arielos/internal/**/I*.aidl",
    ],
}

filegroup {
    name: "ariel-library-sources",
    srcs: ["ariel/lib/main/java/**/*.java"],
}

java_defaults {
    name: "ariel-sdk-defaults",

    // Include aidl files from arielos.app namespace as well as internal src aidl files
    aidl: {
        local_include_dirs: ["sdk/internal/src/java", "sdk/public/src/java"],
    },

    srcs: [
        ":ariel-sdk-internal-sources",
        ":ariel-sdk-sources",
        // For the generated R.java and Manifest.java
        ":com.arielos.platform-res{.aapt.srcjar}",
    ],
}

java_library {
    name: "com.arielos.platform",
    defaults: ["ariel-sdk-defaults"],
    installable: true,
    sdk_version: "core_platform",

    libs: [
        "framework",
        "services",
    ],

    srcs: [
        ":ariel-library-sources",
    ],
}

// Full target for use by platform apps
// ============================================================

java_library {
    name: "com.arielos.platform.internal",
    defaults: ["ariel-sdk-defaults"],
}

// Copy permission file to /system/etc/permissions
// ============================================================
prebuilt_etc {
    name: "com.arielos.platform.xml",
    src: "com.arielos.platform.xml",
    sub_dir: "permissions",
}
