java_import {
    name: "tensorflow-lite-java-2.16.1",
    jars: ["classes.jar"],
    sdk_version: "system_current",  // Use system APIs
}

cc_prebuilt_library_shared {
    name: "libtensorflowlite_jni_2.16.1",
    srcs: [
        "jni/armeabi-v7a/libtensorflowlite_jni.so",
        "jni/arm64-v8a/libtensorflowlite_jni.so",
        "jni/x86/libtensorflowlite_jni.so",
        "jni/x86_64/libtensorflowlite_jni.so",
    ],
    arch: {
        arm: {
            srcs: ["jni/armeabi-v7a/libtensorflowlite_jni.so"],
        },
        arm64: {
            srcs: ["jni/arm64-v8a/libtensorflowlite_jni.so"],
        },
        x86: {
            srcs: ["jni/x86/libtensorflowlite_jni.so"],
        },
        x86_64: {
            srcs: ["jni/x86_64/libtensorflowlite_jni.so"],
        },
    },
}

java_library {
    name: "tensorflow-lite-2.16.1",
    static_libs: ["tensorflow-lite-java-2.16.1"], // Link Java classes
    shared_libs: ["libtensorflowlite_jni_2.16.1"], // Link native libraries
    sdk_version: "system_current",
    visibility: ["//visibility:public"], // Allow usage by other modules
}

