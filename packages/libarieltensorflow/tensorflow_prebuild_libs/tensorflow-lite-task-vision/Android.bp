java_import {
    name: "tensorflow-lite-task-vision-0.4.4",
    jars: ["libs/classes.jar"],
    sdk_version: "system_current",  // Use system APIs
}

cc_prebuilt_library_shared {
    name: "libtask_vision_jni",
    //srcs: [
        //"jni/armeabi-v7a/libtask_vision_jni.so",
        //"jni/arm64-v8a/libtask_vision_jni.so",
        //"jni/x86/libtask_vision_jni.so",
        //"jni/x86_64/libtask_vision_jni.so",
    //],
    shared_libs: ["libc", "libdl", "liblog", "libm"],
    //check_elf_files: false,
    arch: {
        arm: {
            srcs: ["jni/armeabi-v7a/libtask_vision_jni.so"],
        },
        arm64: {
            srcs: ["jni/arm64-v8a/libtask_vision_jni.so"],
        },
    },
}

java_library {
    name: "tensorflow-lite-task-vision",
    static_libs: ["tensorflow-lite-task-vision-0.4.4"], // Link Java classes
    //shared_libs: ["libtask_vision_jni"], // Link native libraries
    sdk_version: "system_current",
    visibility: ["//vendor/ariel/packages/libarieltensorflow",], // Allow usage by other modules
    compile_dex: true,
    installable: true,
    system_ext_specific: true,
}

