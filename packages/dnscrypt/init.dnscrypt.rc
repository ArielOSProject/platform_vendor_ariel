on post-fs-data
    mkdir /data/misc/dnscrypt_proxy 0700 root root

service dnscrypt_proxy /system_ext/bin/dnscrypt-proxy -config /system_ext/etc/dnscrypt-proxy/dnscrypt-proxy.toml
    seclabel u:r:dnscrypt_proxy:s0
    class main
    user root
    group root
    disabled
    capabilities NET_BIND_SERVICE NET_ADMIN NET_RAW

# Sync ariel DNS iptables rules with ariel.online:
#   ariel.online=1  -> apply rules (ariel_dns / ariel_dns6 chains only)
#   otherwise       -> remove ONLY ariel rules (netd chains are never touched)
# The binary serializes concurrent runs and re-checks the property when done.
service iptables-sync /system_ext/bin/iptables_setup --sync
    class late_start
    user root
    group root
    capabilities NET_ADMIN NET_RAW
    seclabel u:r:netd:s0
    oneshot
    disabled

on property:ariel.online=*
    start iptables-sync

# start dnscrypt_proxy after netd daemon;
# re-sync rules too, because a netd (re)start recreates empty oem_out/oem_fwd chains
on property:init.svc.netd=running
    start dnscrypt_proxy
    start iptables-sync
