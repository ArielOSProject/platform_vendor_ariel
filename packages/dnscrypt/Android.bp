cc_prebuilt_binary {
    name: "dnscrypt-proxy",
    // Per-ABI Android builds from the upstream release zips (android_<abi>).
    arch: {
        arm: {
            srcs: ["bin/arm/dnscrypt-proxy"],
        },
        arm64: {
            srcs: ["bin/arm64/dnscrypt-proxy"],
        },
        x86: {
            srcs: ["bin/x86/dnscrypt-proxy"],
        },
        x86_64: {
            srcs: ["bin/x86_64/dnscrypt-proxy"],
        },
    },
    prefer: true,
    system_ext_specific: true,
    installable: true,
    shared_libs: ["liblog"],
    strip: {
        none: true,
    },
}

// Install config file to /system_ext/etc/
prebuilt_etc {
    name: "dnscrypt-proxy-config",
    src: "dnscrypt-proxy.toml",
    sub_dir: "dnscrypt-proxy",
    filename: "dnscrypt-proxy.toml",
    installable: true,
    system_ext_specific: true,
}

// Install blocklist file to /system_ext/etc/
prebuilt_etc {
    name: "dnscrypt-proxy-blocklist",
    src: "blocked-names.txt",
    sub_dir: "dnscrypt-proxy",
    filename: "blocked-names.txt",
    installable: true,
    system_ext_specific: true,
}

// Install cloaking rules (YouTube Restricted Mode) to /system_ext/etc/
prebuilt_etc {
    name: "dnscrypt-proxy-cloaking-rules",
    src: "cloaking-rules.txt",
    sub_dir: "dnscrypt-proxy",
    filename: "cloaking-rules.txt",
    installable: true,
    system_ext_specific: true,
}

// Install init script to /system_ext/etc/init/
prebuilt_etc {
    name: "init.dnscrypt",
    src: "init.dnscrypt.rc",
    sub_dir: "init",
    filename: "init.dnscrypt.rc",
    installable: true,
    system_ext_specific: true,
}
